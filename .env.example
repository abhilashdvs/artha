# Copy to .env.local (local dev) and add the same two variables in Vercel → Settings → Environment Variables.
# Find them in Supabase → Project Settings → API Keys. Use the *publishable* key, never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
